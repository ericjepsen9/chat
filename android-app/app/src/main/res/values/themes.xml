<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main app theme -->
    <style name="Theme.ChatTrade" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#07C160</item>
        <item name="colorPrimaryVariant">#06AD56</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#07C160</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Incoming call theme (dark, fullscreen) -->
    <style name="Theme.ChatTrade.Call" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#1A1A2E</item>
        <item name="android:windowBackground">#1A1A2E</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
